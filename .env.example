# Recommended: configure AI in Settings → AI Connection.
# Optional legacy server-side environment configuration.
AI_ENABLED=false
DEEPSEEK_API_KEY=
PORT=5175
# App-owned daily official recruitment collection (Asia/Shanghai 09:00).
# No AI calls. Server must remain running; startup catches up the latest missed day.
RECRUITMENT_AUTO_UPDATE=true
# Optional HTTP proxy for the collector; leave blank on the server unless needed.
RECRUITMENT_PROXY=

# Optional outbound proxy (Node 24.14+ / 25.4+); local browser requests bypass it.
APP_HTTP_PROXY=
