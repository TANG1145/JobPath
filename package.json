{
  "name": "jobpath",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node server.mjs",
    "build": "tsc --noEmit && vite build",
    "test": "node --test tests/*.test.js",
    "invite": "node scripts/create-invite.mjs",
    "catalog": "node scripts/export-catalog.mjs",
    "test:e2e": "playwright test",
    "verify:videos": "node scripts/verify-resource-videos.mjs",
    "dev:ui": "vite",
    "test:core": "tsx --test tests/unit/*.test.ts tests/migration/*.test.ts",
    "test:legacy": "node scripts/legacy-baseline.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "^4.6.7"
  }
}
